# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Admin login (only this email can sign in)
ADMIN_EMAIL=developer@scubafy.co
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secret for signed admin sessions (e.g. openssl rand -base64 32)
AUTH_SECRET=

# Public site URL used in sitemap / SEO
NEXT_PUBLIC_SITE_URL=https://scubafysolutions.com

# Optional: Vercel Blob for production image uploads
# Without this, uploads save to /public/uploads in local development
BLOB_READ_WRITE_TOKEN=
